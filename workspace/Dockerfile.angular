# Angular multi-stage build (compile + serve from nginx)
FROM node:18-alpine AS builder

WORKDIR /app
COPY app/angular/package*.json ./
RUN npm install --legacy-peer-deps

COPY app/angular/ .
RUN npm run build

# Production: serve from nginx
FROM nginx:alpine

# Copy nginx config
COPY nginx-angular.conf /etc/nginx/nginx.conf

# Copy compiled Angular app from builder
COPY --from=builder /app/dist/chore-app /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
