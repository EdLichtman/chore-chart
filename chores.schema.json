{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "chores.schema.json",
  "title": "Chore Checklist",
  "description": "Schema for chores.json — the weekly chore checklist data file.",
  "type": "object",
  "required": ["gridProperties", "daily", "categories"],
  "additionalProperties": false,
  "properties": {
    "gridProperties": {
      "type": "object",
      "required": ["print", "web"],
      "additionalProperties": false,
      "properties": {
        "print": { "$ref": "#/$defs/gridConfig" },
        "web":   { "$ref": "#/$defs/gridConfig" }
      }
    },
    "daily": {
      "type": "array",
      "items": { "$ref": "#/$defs/dailyChore" }
    },
    "categories": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/category" }
    }
  },

  "$defs": {
    "gridConfig": {
      "type": "object",
      "required": ["columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "columns": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 6 },
            { "type": "string", "const": "auto" }
          ]
        },
        "rows": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "string", "const": "auto" }
          ]
        }
      }
    },

    "interval": {
      "type": "object",
      "description": "How often this chore recurs. Controls due-date projection — the checklist advances the due date by this interval to find which week the chore belongs in. Use { unit: 'month', n: 12 } for annual chores; 'year' is equivalent but 'month' is preferred for consistency.",
      "required": ["n", "unit"],
      "additionalProperties": false,
      "properties": {
        "n":    { "type": "integer", "minimum": 1, "description": "Number of units between recurrences. E.g. n:2 unit:'week' = every 2 weeks; n:12 unit:'month' = once a year." },
        "unit": { "type": "string", "enum": ["day", "week", "month", "year"] }
      }
    },

    "lastAligned": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO date of last completion (YYYY-MM-DD)"
        },
        {
          "type": "string",
          "const": "pending",
          "description": "Chore has never been completed — show immediately and flag as pending"
        }
      ]
    },

    "cadenceEntry": {
      "type": "object",
      "required": ["startDate"],
      "additionalProperties": false,
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
          "description": "MM-DD when this cadence window begins"
        },
        "interval": { "$ref": "#/$defs/interval" },
        "status": {
          "type": "string",
          "const": "inactive",
          "description": "Set to inactive to suppress the chore during this window"
        }
      }
    },

    "requirement": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id":          { "type": "string" },
        "name":        { "type": "string" },
        "interval":    { "$ref": "#/$defs/interval" },
        "lastAligned": { "$ref": "#/$defs/lastAligned" }
      }
    },

    "chore": {
      "type": "object",
      "required": ["id", "name", "interval", "weekPin", "dayPin", "notes", "requirements", "annualCadence", "canBeOverdue"],
      "additionalProperties": false,
      "properties": {
        "id":   { "type": "string" },
        "name": { "type": "string" },
        "interval": { "$ref": "#/$defs/interval" },
        "weekPin": {
          "oneOf": [
            { "type": "string", "enum": ["odd", "even"] },
            { "type": "null" }
          ],
          "description": "Pin bi-weekly chore to odd or even ISO weeks"
        },
        "dayPin": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 31 },
            { "type": "null" }
          ],
          "description": "Preferred day of month (1–31)"
        },
        "lastAligned": { "$ref": "#/$defs/lastAligned" },
        "notes":        { "type": "array", "items": { "type": "string" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
        "annualCadence":{
          "type": "array",
          "items": { "$ref": "#/$defs/cadenceEntry" },
          "description": "Optional seasonal gate — defines windows when the chore is active or inactive, independent of interval. Use this when the chore must appear only in specific months regardless of when it was last completed (e.g. Winterize House only in November). Without annualCadence, the chore is always active and appears every `interval`. With annualCadence, the chore is still projected by `interval`, but suppressed outside the active window. Entries must be in chronological order by startDate. The last entry's window extends to year-end and wraps to the first entry."
        },
        "canBeOverdue": {
          "type": "boolean",
          "description": "Whether the chore should be flagged when past due beyond the grace window"
        }
      }
    },

    "dailyChore": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id":    { "type": "string" },
        "name":  { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },

    "category": {
      "type": "object",
      "required": ["label", "chores"],
      "additionalProperties": false,
      "properties": {
        "label":  { "type": "string" },
        "chores": { "type": "array", "items": { "$ref": "#/$defs/chore" } }
      }
    }
  }
}
